 +                } else {
 +                    pwdMatchMsg.className = 'form-text text-danger mt-2';
 +                    pwdMatchMsg.innerHTML = '<i class="fa fa-times-circle me-1"></i> Mß║¡t khß║⌐u kh├┤ng khß╗¢p';
